<addons>
<addon id="plugin.video.flixplay"
       name="FLIX PLAY"
       version="1.5.14"
       provider-name="Flix Play">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
        <summary lang="pt_BR">Flix Play</summary>
        <description lang="pt_BR">Catálogo e reprodução de conteúdo.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
    </extension>
</addon>
	<addon id="plugin.audio.tvemradios" name="VOZES NO AR" version="1.3.0" provider-name="Team vianna">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">Radios brasileiras ao vivo</summary>
    <description lang="pt_BR">Radios do Brasil ao vivo, organizadas por estado, cidade e estilo musical, com pesquisa e favoritos. (radio, radios online, FM, AM)</description>
    <platform>all</platform>
    <license>Proprietary</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
	<addon id="plugin.video.tvemlives" name="AO VIVO" version="4.9.0" provider-name="TV EMINEM">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">Transmissoes ao vivo do YouTube organizadas por categoria</summary>
    <description lang="pt_BR">Reune os canais oficiais do YouTube que voce cadastrar, separados por categoria (futebol, desenhos, noticias, etc), e mostra quais estao ao vivo no momento. A reproducao e feita pelo complemento oficial do YouTube.</description>
    <platform>all</platform>
    <license>Proprietary</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
	<addon id="plugin.video.tvemtrailers" name="TV EMINEM - Trailers" version="2.1.5" provider-name="TV EMINEM">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">Reproducao leve dos trailers do YouTube</summary>
        <description lang="pt_BR">Toca os trailers do YouTube pegando o endereco direto do video, sem API nem cache pesado. Mais fluido e sem travar. Se nao conseguir, usa o complemento oficial do YouTube.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <assets><icon>icon.png</icon></assets>
    </extension>
</addon>
	<addon id="plugin.program.tvemtemas" name="Team Vianna - Temas" version="1.6.1" provider-name="Team Vianna">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">Temas de fundo</summary>
        <description lang="pt_BR">Escolha um tema (Natal, Páscoa...) com imagem de fundo fixa, ou volte ao padrão com as fanarts dos filmes e séries.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
