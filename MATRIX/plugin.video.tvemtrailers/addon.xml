<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tvemtrailers" name="TV EMINEM - Trailers" version="2.1.1" provider-name="TV EMINEM">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="pt_BR">Reproducao leve dos trailers do YouTube</summary>
        <description lang="pt_BR">Toca os trailers do YouTube pegando o endereco direto do video, sem API nem cache pesado. Mais fluido e sem travar. Se nao conseguir, usa o complemento oficial do YouTube.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
        <assets><icon>icon.png</icon></assets>
    </extension>
</addon>
