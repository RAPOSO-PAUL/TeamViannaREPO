<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tvemlives" name="AO VIVO" version="4.6.0" provider-name="Team Vianna">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">MENOS PROCURANDO... MAIS ASSISTINDO</summary>
    <description lang="pt_BR">Reune os canais ao vivo, separados por categoria (futebol, desenhos, noticias, etc), e mostra quais estao ao vivo no momento ou em breve.</description>
    <platform>all</platform>
    <license>Proprietary</license>
    <assets>
      <icon>resources/media/icon.png</icon>
      <fanart>resources/media/fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
